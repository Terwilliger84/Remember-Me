<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/li_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg_r8"
    android:forceDarkAllowed="false"
    android:padding="1dp">

    <LinearLayout
        android:id="@+id/li_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_bg_r7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="4.5dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4.5dp">

        <TextView
            android:id="@+id/li_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="11.2sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/li_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="9.8sp" />

        <TextView
            android:id="@+id/li_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_bg_r5"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1.5dp"
            android:singleLine="true"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
